# Build Configuration
DISABLE_ESLINT_PLUGIN=true

# Umami Analytics (optional - leave empty to disable)
# Using Umami Cloud (free Hobby tier): sign up at https://cloud.umami.is,
# add your site, then paste its Website ID below. Both vars must be set to enable.
REACT_APP_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
REACT_APP_UMAMI_WEBSITE_ID=

# PocketBase API for sharing features
# Default: https://debate-dissector-api.fly.dev
REACT_APP_API_URL=
